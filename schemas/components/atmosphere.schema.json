{
  "$schema": "https://json-schema.org/draft-2020-12/schema",
  "$id": "https://helios.zero/schemas/components/atmosphere.schema.json",
  "title": "Atmosphere Component",
  "type": "object",
  "properties": {
    "type": { "const": "atmosphere" },
    "composition": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "fraction": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    },
    "surface_pressure": {
      "type": "object",
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "enum": ["Pa", "bar", "atm"] }
      },
      "required": ["value", "unit"],
      "additionalProperties": false
    }
  },
  "required": ["type"],
  "additionalProperties": false
}
