{
  "$schema": "https://json-schema.org/draft-2020-12/schema",
  "$id": "https://helios.zero/schemas/common/measurement.schema.json",
  "title": "Measurement",
  "description": "A scientific measurement with explicit units, optional uncertainty, and provenance source.",
  "type": "object",
  "properties": {
    "value": { "type": "number" },
    "unit": {
      "type": "string",
      "enum": [
        "m", "km", "AU", "pc", "ly", "kg", "M_earth", "M_jupiter", "M_sun",
        "R_earth", "R_jupiter", "R_sun", "L_sun", "K", "deg", "rad", "m/s",
        "km/s", "mas", "mas/yr", "arcsec/yr", "day", "yr", "Myr", "Gyr",
        "mag", "W", "Jy"
      ]
    },
    "uncertainty": {
      "oneOf": [
        { "type": "number", "minimum": 0 },
        {
          "type": "object",
          "properties": {
            "plus": { "type": "number" },
            "minus": { "type": "number" }
          },
          "required": ["plus", "minus"],
          "additionalProperties": false
        }
      ]
    },
    "source": { "type": "string" }
  },
  "required": ["value", "unit"],
  "additionalProperties": false
}
