{
  "$schema": "https://json-schema.org/draft-2020-12/schema",
  "$id": "https://helios.zero/schemas/common/identity.schema.json",
  "title": "Identity & Provenance",
  "description": "Immutable identity, classification, discovery, status, relationships, and bibliography provenance.",
  "type": "object",
  "properties": {
    "identity": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "designations": { "type": "array", "items": { "type": "string" } },
        "classification": {
          "type": "object",
          "properties": {
            "primary": { "type": "string" },
            "subtype": { "type": "string" },
            "spectral_type": { "type": "string" },
            "variable_type": { "type": "string" }
          },
          "required": ["primary"],
          "additionalProperties": false
        }
      },
      "required": ["name", "classification"],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": ["confirmed", "candidate", "disputed", "retracted", "historical", "hypothetical"]
    },
    "relationships": {
      "type": "object",
      "properties": {
        "parent": { "type": "string" },
        "companions": { "type": "array", "items": { "type": "string" } },
        "children": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "discovery": {
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "discoverer": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "institution": { "type": "string" },
        "method": { "type": "string" }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "citation": { "type": "string" },
          "doi": { "type": "string" },
          "url": { "type": "string" },
          "accessed": { "type": "string" }
        },
        "required": ["type", "citation"],
        "additionalProperties": false
      }
    }
  },
  "required": ["identity"],
  "additionalProperties": false
}
